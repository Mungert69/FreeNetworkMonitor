#!/bin/sh
set -e

git pull
npm i 
export VITE_AGENT_DOTNET_SDK_VERSION=`dotnet --version 2>/dev/null || echo unknown`
npm run build
mkdir -p ./out/images
mkdir -p ./out/blogpics
cp -r ../FreeNetworkMonitorBlog/public/images ./out/
cp -r ../FreeNetworkMonitorBlog/public/blogpics ./out/
docker buildx inspect multiarch-builder >/dev/null 2>&1 || docker buildx create --name multiarch-builder --use
docker buildx use multiarch-builder
docker buildx inspect --bootstrap
docker buildx build \
  --platform linux/amd64,linux/arm64 \
  --file ./Dockerfile \
  --tag mungert/networkmonitorreact:1.4.2 \
  --push \
  .

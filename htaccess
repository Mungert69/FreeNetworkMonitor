RewriteEngine On

ErrorDocument 404 /404.html

# Consolidate the production www alias without affecting development hosts.
RewriteCond %{HTTP_HOST} ^www\.readyforquantum\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://readyforquantum.com%{REQUEST_URI} [R=301,L,NE]

# Legacy blog entry points go directly to the current blog host.
RewriteRule ^blog(?:/index\.html)?/?$ https://blog.readyforquantum.com/ [R=301,L,NC]
RewriteRule ^blog/((?:posts|categories|page)/.+)$ https://blog.readyforquantum.com/$1 [R=301,L]

# Expanded from the shared route catalogue by scripts/generate-apache-routes.mjs.
# GENERATED_PUBLIC_ALIASES

# Existing generated documents and assets are served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Only known application routes use the SPA shell. Preserve their query strings
# (including login callbacks and dashboard deep links) without rewriting the URL.
RewriteRule ^(?:dashboard|start-login-proxy)/?$ /index.html [L,NC]

# Unknown public pages and missing assets must not look like the homepage.
RewriteRule ^ - [R=404,L]
